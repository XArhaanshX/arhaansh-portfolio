// Cloudflare deploy of the browser product: `bun run deploy:cf` (see README "Cloudflare").
// Account comes from CLOUDFLARE_ACCOUNT_ID in the environment; secrets via `wrangler secret`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arhaansh-me",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "bun server/bundle.ts" },
  // dist/app.js + favicon, served before the Worker runs; every other path reaches the Worker
  "assets": { "directory": "dist" },
  // served at arhaansh-me.<account>.workers.dev until a custom domain is added under "routes":
  //   "routes": [{ "pattern": "example.com", "custom_domain": true }]
  "workers_dev": true,
  // .data on Cloudflare: one KV entry per .data-relative file (visits.json, spotify.json, ...).
  // Create it once with `bunx wrangler kv namespace create DATA` and paste the id here.
  "kv_namespaces": [{ "binding": "DATA", "id": "7e1f5a01e6574765be47424144c4c924" }],
  "vars": { "NODE_ENV": "production", "PUBLIC_ORIGIN": "https://arhaansh.me" },
  // daily re-derive of the project labels into KV (server/worker.ts `scheduled`)
  "triggers": { "crons": ["17 9 * * *"] },
  "observability": { "enabled": true }
}
